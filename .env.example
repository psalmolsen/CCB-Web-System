# ────────────────────────────────────────────────────────────────────────────
# CCB Inventory System - Environment Variables Template
# ────────────────────────────────────────────────────────────────────────────
#
# IMPORTANT: This file contains EXAMPLE PLACEHOLDER VALUES ONLY.
#
# DO NOT commit real secrets, API keys, credentials, or passwords to git.
# Copy this file to .env.local and fill in actual values for local development.
#
# For production, use your deployment platform's secret management:
# - GitHub Actions Secrets
# - Docker/Kubernetes secrets
# - AWS Secrets Manager
# - Google Cloud Secret Manager
# - HashiCorp Vault
#
# ────────────────────────────────────────────────────────────────────────────
# Backend API Configuration
# ────────────────────────────────────────────────────────────────────────────

# Backend server URL for API calls (used if running backend separately)
# Leave empty if backend runs on same host (default: /api)
VITE_API_BASE_URL=/api

# Backend port (if applicable)
BACKEND_PORT=5000

# ────────────────────────────────────────────────────────────────────────────
# Google Cloud / Google Sheets Configuration
# ────────────────────────────────────────────────────────────────────────────

# Path to Google Cloud service account JSON file (DO NOT COMMIT THIS FILE)
# Handled server-side, not in frontend code
GOOGLE_APPLICATION_CREDENTIALS=./backend/service-account.json

# Google Sheets API configuration
GOOGLE_SHEETS_API_KEY=YOUR_GOOGLE_SHEETS_API_KEY_HERE
GOOGLE_SHEETS_SPREADSHEET_ID=YOUR_SPREADSHEET_ID_HERE

# ────────────────────────────────────────────────────────────────────────────
# Database Configuration (if applicable)
# ────────────────────────────────────────────────────────────────────────────

# MongoDB / PostgreSQL / MySQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/ccb_inventory

# Database pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# ────────────────────────────────────────────────────────────────────────────
# Authentication & Security
# ────────────────────────────────────────────────────────────────────────────

# JWT Secret (for token signing - DO NOT COMMIT THIS)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# JWT expiration time
JWT_EXPIRATION=24h

# Session secret
SESSION_SECRET=your_session_secret_here

# CORS allowed origins
VITE_CORS_ORIGIN=http://localhost:5173

# ────────────────────────────────────────────────────────────────────────────
# Third-party Services (if applicable)
# ────────────────────────────────────────────────────────────────────────────

# Stripe API Keys (DO NOT COMMIT THESE)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# OpenAI / GPT API Key (DO NOT COMMIT THIS)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Firebase Admin SDK (handled server-side, path-based)
FIREBASE_CONFIG_PATH=./backend/firebase-adminsdk.json

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AWS (if applicable - DO NOT COMMIT THESE)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1

# ────────────────────────────────────────────────────────────────────────────
# Application Settings
# ────────────────────────────────────────────────────────────────────────────

# Environment
NODE_ENV=development

# API request timeout (milliseconds)
API_TIMEOUT=30000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging level
LOG_LEVEL=info

# ────────────────────────────────────────────────────────────────────────────
# Email Configuration (if applicable)
# ────────────────────────────────────────────────────────────────────────────

# SMTP settings (DO NOT COMMIT PASSWORDS)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=noreply@ccb-inventory.local

# ────────────────────────────────────────────────────────────────────────────
# Security Headers
# ────────────────────────────────────────────────────────────────────────────

# Content Security Policy (CSP)
CSP_DIRECTIVE=default-src 'self'

# Other security settings
SECURE_COOKIES=true
SAME_SITE=strict

# ────────────────────────────────────────────────────────────────────────────
# IMPORTANT SECURITY NOTES
# ────────────────────────────────────────────────────────────────────────────
#
# 1. NEVER commit .env, .env.local, or any file containing real secrets
# 2. Always use .env.example with PLACEHOLDER values only
# 3. Store real secrets in your deployment platform's secret manager
# 4. Rotate credentials regularly
# 5. Use different keys for development, staging, and production
# 6. Revoke any secrets that have been committed to git history
# 7. Use git hooks to prevent accidental secret commits
#
# For local development setup:
#   1. Copy this file: cp .env.example .env.local
#   2. Edit .env.local with your actual credentials
#   3. Never commit .env.local
#
# ────────────────────────────────────────────────────────────────────────────
